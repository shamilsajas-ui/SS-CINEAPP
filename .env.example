# Database Configuration (Neon Serverless PostgreSQL via Vercel Marketplace)
# Pooled connection string for regular serverless queries
DATABASE_URL=postgresql://neondb_owner:npg_password@ep-cold-shadow-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Direct/unpooled connection string for migrations and DDL operations
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:npg_password@ep-cold-shadow-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# App Secrets
JWT_SECRET=cinebook_super_secret_jwt_key_min_32_chars_long_production_ready!
CRON_SECRET=cinebook_cron_secret_auth_token_for_releasing_expired_holds_9988

# Payment Gateway (Stripe Test Mode)
# In development/demo, CineBook also features a built-in Mock Payment Simulator
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_sample_cinebook_publishable_key
STRIPE_SECRET_KEY=sk_test_sample_cinebook_secret_key
STRIPE_WEBHOOK_SECRET=whsec_sample_cinebook_webhook_secret

# Vercel Blob (Optional for movie poster uploads)
BLOB_READ_WRITE_TOKEN=vercel_blob_sample_token

# Public Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
